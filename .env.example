# Copy this file to .env and enter your key there. Never commit .env.
OPENAI_API_KEY=
OPENAI_INTERVIEW_MODEL=gpt-6.1-terra
OPENAI_SEARCH_MODEL=gpt-6.1-sol
JOBENGINE_BUDGET_USD=10

# Django defaults to loopback development. See README before public deployment.
DJANGO_DEBUG=1
# In development, a secret is generated in JOBENGINE_DATA_DIR if this is blank.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Import previous local profiles only on loopback in development.
JOBENGINE_LOCAL_LIBRARY=1
